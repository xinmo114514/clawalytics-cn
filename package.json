{
  "name": "clawalytics-cn-desktop",
  "version": "0.7.9",
  "description": "Cost-tracking analytics dashboard for OpenClaw - track AI spending across 100+ models, monitor agents, analyze channels, and manage security",
  "author": "David Novotny",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "concurrently \"corepack pnpm dev:client\" \"corepack pnpm dev:server\"",
    "dev:client": "vite",
    "dev:server": "node scripts/ensure-native-deps.mjs && tsx watch src/server/index.ts",
    "dev:desktop": "node scripts/ensure-native-deps.mjs && corepack pnpm build && node scripts/run-electron-builder.mjs install-app-deps && electron electron/main.mjs",
    "build": "corepack pnpm build:client && corepack pnpm build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:desktop": "corepack pnpm build && node scripts/run-electron-builder.mjs install-app-deps && node scripts/run-electron-builder.mjs --win nsis",
    "test:openclaw": "node scripts/ensure-native-deps.mjs && node --import tsx scripts/test-openclaw-data-pipeline.mjs",
    "test:hermes": "node scripts/ensure-native-deps.mjs && node --import tsx scripts/test-hermes-data-pipeline.mjs && node --import tsx scripts/test-data-source-config.mjs",
    "test:desktop-notifications": "node scripts/test-desktop-notifications.mjs",
    "test:analytics": "node --import tsx scripts/test-analytics-regressions.mjs",
    "test:security-boundary": "node --import tsx scripts/test-security-boundary.mjs",
    "test:request-trust": "node --import tsx scripts/test-request-trust.mjs",
    "test:desktop-security": "node scripts/test-desktop-security.mjs",
    "test:desktop-e2e": "node scripts/test-desktop-e2e.mjs",
    "test:pairing-sync": "node --import tsx scripts/test-pairing-sync.mjs",
    "test:input-safety": "node --import tsx scripts/test-input-safety.mjs",
    "test:wsl-platform": "node --import tsx scripts/test-wsl-platform.mjs",
    "rebuild:native": "node scripts/ensure-native-deps.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "format:check": "prettier --check --end-of-line auto .",
    "format": "prettier --write .",
    "test:server-binding": "node scripts/ensure-native-deps.mjs && node --import tsx scripts/test-server-binding.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "express": "^5.1.0",
    "framer-motion": "^12.32.0",
    "json5": "^2.2.3",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-day-picker": "9.12.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "react-top-loading-bar": "^3.0.2",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.2.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router": "^1.141.2",
    "@tanstack/react-router-devtools": "^1.141.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.141.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "concurrently": "^9.1.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.3.0"
  },
  "keywords": [
    "openclaw",
    "claude-code",
    "claude",
    "anthropic",
    "ai-costs",
    "token-tracking",
    "analytics",
    "openai",
    "llm",
    "api-costs",
    "dashboard",
    "cost-tracking",
    "prompt-caching",
    "agent-monitoring"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinmo114514/clawalytics-cn.git"
  },
  "homepage": "https://github.com/xinmo114514/clawalytics-cn#readme",
  "bugs": {
    "url": "https://github.com/xinmo114514/clawalytics-cn/issues"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "2.3.0",
      "path-to-regexp": "8.4.2",
      "qs": "6.16.0"
    }
  },
  "build": {
    "appId": "com.clawalytics.desktop",
    "productName": "Clawalytics",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/images/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "afterPack": "scripts/prepare-nsis-app-dir.cjs",
    "afterSign": "scripts/prepare-nsis-app-dir.cjs",
    "npmRebuild": true,
    "win": {
      "icon": "public/images/app-icon.ico",
      "signAndEditExecutable": true,
      "target": "nsis"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-x64-portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-x64-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "scripts/custom-nsis.generated.nsh"
    }
  }
}
